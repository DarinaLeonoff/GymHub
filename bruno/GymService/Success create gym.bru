meta {
  name: Success create gym
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{gymProfile}}
  body: json
  auth: inherit
}

body:json {
  {
  "name": "Base Gym",
  "description": "Базовое описание зала для тестов обновления",
  "address": "г. Москва, ул. Ленина, д. 1",
  "tel": "+79991112233",
  "email": "base@gymhub.ru"
  }
}

script:post-response {
  test("status code is 200 or 201", function() {
  expect(res.status).to.be.oneOf([200, 201]);
  });
  test("save gym id to runtime variable", function() {
  expect(res.body.id).to.be.a('number');
  bru.setVar("gym_id", res.body.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
