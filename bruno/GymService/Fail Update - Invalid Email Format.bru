meta {
  name: Fail Update - Invalid Email Format
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}{{gymProfile}}/1
  body: json
  auth: inherit
}

body:json {
  {
  "email": "bad-email-without-at"
  }
}

script:post-response {
  test("status code is 400", function() {
  expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
