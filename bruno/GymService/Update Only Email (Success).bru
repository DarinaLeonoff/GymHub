meta {
  name: Update Only Email (Success)
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}{{gymProfile}}/1
  body: json
  auth: inherit
}

body:json {
  {
  "email": "new-email@gymhub.ru"
  }
  
}

script:post-response {
  test("status code is 200", function() {
  expect(res.status).to.equal(200);
  });
  
  test("email is updated", function() {
  expect(res.body.email).to.equal("new-email@gymhub.ru");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
