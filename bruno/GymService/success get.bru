meta {
  name: success get
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}{{gymProfile}}/1
  body: none
  auth: inherit
}

script:post-response {
  test("status code is 200", function() {
  expect(res.status).to.equal(200);
  });
  
  test("Id of gym is 1", function() {
  expect(res.getBody().id).to.equal(1);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
